{
  "name": "auction-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec node --loader tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "db:setup": "node --loader tsx scripts/setup-db.ts",
    "db:seed": "node --loader tsx scripts/seed-db.ts",
    "db:migrate": "node --loader tsx scripts/migrate-db.ts"
  },
  "dependencies": {
    "express": "^4.18.0",
    "typescript": "^5.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "pg": "^8.11.0",
    "dotenv": "^16.3.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.0",
    "socket.io": "^4.7.0",
    "cors": "^2.8.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.0",
    "joi": "^17.11.0",
    "uuid": "^9.0.0",
    "axios": "^1.6.0",
    "stripe": "^13.10.0",
    "nodemailer": "^6.9.0",
    "@types/nodemailer": "^6.4.0",
    "multer": "^1.4.0",
    "@types/multer": "^1.4.0",
    "sharp": "^0.32.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "tsx": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}
